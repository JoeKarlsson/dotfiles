{{- if eq .chezmoi.os "windows" -}}
# Points $PROFILE at the chezmoi-managed ~/.config/powershell/profile.ps1.
# $PROFILE's folder depends on Documents redirection (OneDrive or not), so
# chezmoi can't own that file directly; this adds one dot-source line instead.
# Covers Windows PowerShell 5.1 and, once installed, PowerShell 7.
$ErrorActionPreference = 'Stop'

# The default policy (Restricted) refuses to run any profile at all
if ((Get-ExecutionPolicy -Scope CurrentUser) -eq 'Undefined' -and
    (Get-ExecutionPolicy -Scope LocalMachine) -in 'Undefined', 'Restricted') {
    # This script runs under -ExecutionPolicy Bypass, so the change succeeds but
    # also throws "overridden by a more specific scope"; ignore that, verify instead.
    try { Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force } catch {}
    if ((Get-ExecutionPolicy -Scope CurrentUser) -ne 'RemoteSigned') { throw 'Could not set the execution policy' }
    'Execution policy set to RemoteSigned for the current user'
}

$line = '. "$HOME\.config\powershell\profile.ps1"'
$docs = [Environment]::GetFolderPath('MyDocuments')
foreach ($dir in 'WindowsPowerShell', 'PowerShell') {
    $profilePath = Join-Path $docs "$dir\Microsoft.PowerShell_profile.ps1"
    if ((Test-Path $profilePath) -and (Select-String -Path $profilePath -SimpleMatch $line -Quiet)) { continue }
    New-Item -ItemType Directory -Force (Split-Path $profilePath) | Out-Null
    Add-Content -Path $profilePath -Value $line -Encoding ascii
    "Added dotfiles loader to $profilePath"
}
{{ end -}}
