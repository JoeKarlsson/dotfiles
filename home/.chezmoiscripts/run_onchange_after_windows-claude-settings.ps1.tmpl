{{- if eq .chezmoi.os "windows" -}}
# Claude Code settings for Windows, from .chezmoitemplates/claude-settings-windows.json.
# Not a regular managed file: on the Macs ~/.claude/settings.json is a symlink
# into the repo, and chezmoi can't map two sources to one target. Runs whenever
# that JSON changes. Repo keys win; keys only in the local file (ones Claude
# Code adds itself, like autoUpdatesChannel) are kept. The old file is backed up.
$ErrorActionPreference = 'Stop'

$desired = @'
{{ include ".chezmoitemplates/claude-settings-windows.json" | trim }}
'@
$target = Join-Path $HOME '.claude\settings.json'
$wanted = $desired | ConvertFrom-Json
$out = $desired

if (Test-Path $target) {
    $current = Get-Content $target -Raw
    $extra = @()
    if ($current.Trim()) {
        foreach ($p in ($current | ConvertFrom-Json).PSObject.Properties) {
            if ($wanted.PSObject.Properties.Name -notcontains $p.Name) {
                $extra += '  "{0}": {1}' -f $p.Name, (ConvertTo-Json $p.Value -Depth 20 -Compress)
            }
        }
    }
    if ($extra) { $out = $desired.Substring(0, $desired.LastIndexOf('}')).TrimEnd() + ",`n" + ($extra -join ",`n") + "`n}" }
    if ($current.Trim() -eq $out.Trim()) { return }
    Copy-Item $target "$target.bak-$(Get-Date -Format yyyyMMdd-HHmmss)"
}
New-Item -ItemType Directory -Force (Split-Path $target) | Out-Null
# UTF-8 without a BOM (Set-Content -Encoding utf8 adds one in Windows PowerShell)
[IO.File]::WriteAllText($target, $out + "`n")
"Wrote Claude Code settings to $target"
{{ end -}}
