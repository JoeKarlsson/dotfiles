# ========================================
# mise (runtime versions: node; per-project via mise.toml / .nvmrc)
# ========================================
# Shims instead of `mise activate`: no hook before every prompt (~20ms each).
# Shims still pick the per-directory version when they run; only [env]
# sections in mise.toml are not applied. Use `mise x -- cmd` if one ever is.
export PATH="$HOME/.local/share/mise/shims:$PATH"

export PATH="$HOME/bin:$PATH"

# Jump to cdata project
