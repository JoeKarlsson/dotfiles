# ========================================
# fzf (Ctrl-T files, Alt-C dirs) + zoxide (z / zi) + atuin (Ctrl-R history)
# zoxide goes after other cd wrappers; syntax-highlighting below must be last
# ========================================
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
# Cache each tool's init script instead of spawning it on every startup.
# Keyed on the resolved binary path (Cellar path includes the version), so a
# brew upgrade regenerates it automatically.
_cached_init() {  # _cached_init <name> <cmd> [args...]
  local name=$1; shift
  local bin=${commands[$1]:A} cache=~/.cache/zsh/init-$name.zsh
  if [[ ! -s $cache || "$(<$cache.src)" != $bin ]] 2>/dev/null; then
    mkdir -p ${cache:h} && "$@" >| $cache && print -r -- $bin >| $cache.src
  fi
  source $cache
}
_cached_init fzf fzf --zsh
_cached_init zoxide zoxide init zsh
# atuin after fzf so it owns Ctrl-R (fzf keeps Ctrl-T / Alt-C). Up arrow stays
# the prefix search above; the AI feature stays off.
_cached_init atuin atuin init zsh --disable-up-arrow --disable-ai
# atuin's init points autosuggestions at `atuin search`, one process per
# keystroke. zsh's own history lookup is instant, so use that instead.
ZSH_AUTOSUGGEST_STRATEGY=(history)

# OpenRouter key lives in the macOS Keychain, never in this repo.
# Store/rotate: security add-generic-password -U -a "$USER" -s openrouter-api-key -w '<key>'
export OPENROUTER_API_KEY="$(security find-generic-password -a "$USER" -s openrouter-api-key -w 2>/dev/null)"
# OpenCode -> LiteLLM (CT 261) virtual key "opencode", so its usage is tracked there.
export LITELLM_OPENCODE_KEY="$(security find-generic-password -a "$USER" -s litellm-opencode-key -w 2>/dev/null)"

