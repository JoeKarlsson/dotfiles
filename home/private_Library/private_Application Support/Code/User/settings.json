{
  "files.autoSave": "afterDelay",
  "editor.wordWrap": "on",
  "editor.fontLigatures": true,
  "editor.suggestSelection": "first",
  "codespaces.accountProvider": "Microsoft",
  "remote.SSH.connectTimeout": 120,
  // Let the HA dashboards folder auto-start its lovelace-cache watcher task.
  "task.allowAutomaticTasks": "on",
  // Home Assistant over Remote-SSH. serverInstallPath must be a persistent
  // add-on path (/data), or the VS Code server is wiped on every add-on restart.
  "remote.SSH.remotePlatform": {
    "homeassistant": "linux",
    "ha": "linux",
  },
  "remote.SSH.serverInstallPath": {
    "homeassistant": "/data",
    "ha": "/data",
  },
  "yaml.customTags": [
    "!include scalar",
    "!include_dir_list scalar",
    "!include_dir_merge_list scalar",
    "!include_dir_named scalar",
    "!include_dir_merge_named scalar",
    "!secret scalar",
    "!env_var scalar",
    "!input scalar",
    "!lambda scalar",
  ],
  "explorer.confirmDragAndDrop": false,
  "liveshare.authenticationProvider": "GitHub",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Monokai",
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.formatOnPaste": true,
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.iconTheme": "vscode-icons",
  "vsicons.dontShowNewVersionMessage": true,
  "editor.formatOnSave": true,
  "explorer.confirmDelete": false,
  "editor.linkedEditing": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "javascript": true,
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "github.copilot.autocomplete.enable": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "cSpell.userWords": [
    "Alexa",
    "beaglebone",
    "goutils",
    "Greenberg",
    "Jacobowitz",
    "Jamf",
    "Karlsson",
    "Pandoc",
    "singlestore",
    "socio",
    "Tinybird",
    "Viam",
    "webevents",
  ],
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "editor.inlineSuggest.enabled": true,
  "git.ignoreMissingGitWarning": true,
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true,
    "suppressIntegrationRequestTimedOutWarning": true,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "go.toolsManagement.autoUpdate": true,
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "git.ignoreRebaseWarning": true,
  "markdown.updateLinksOnFileMove.enabled": "always",
  "npm.keybindingsChangedWarningShown": true,
  "markdownlint.config": {},
  "files.associations": {
    "*.md": "markdown",
  },
  "cSpell.autoFormatConfigFile": true,
  "editor.formatOnType": true,
  "vale.valeCLI.path": "/opt/homebrew/bin/vale",
  "vale.enable": false,
  "vale.valeCLI.minAlertLevel": "suggestion",
  "settingsSync.ignoredExtensions": ["wakatime.vscode-wakatime"],
  "window.zoomLevel": -1,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "vale.enableSpellcheck": true,
  "githubPullRequests.pullBranch": "never",
  "update.showReleaseNotes": false,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.nextEditSuggestions.enabled": true,
  "makefile.configureOnOpen": true,
  "redhat.telemetry.enabled": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "parallels-desktop.extension.path": "/Users/joekarlsson/.parallels-desktop-vscode",
  "parallels-desktop.prlctl.path": "/usr/local/bin/prlctl",
  "parallels-desktop.brew.path": "/opt/homebrew/bin/brew",
  "parallels-desktop.git.path": "/opt/homebrew/bin/git",
  "parallels-desktop.devops-service.path": "/Users/joekarlsson/.parallels-desktop-vscode/tools/prldevops",
}
