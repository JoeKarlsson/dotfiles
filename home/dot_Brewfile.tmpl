# Brewfile - Joe Karlsson's Mac Setup
# Install with: brew bundle --file=~/dotfiles/Brewfile
# Updated: 2026-09-29 (pruned unused tools; `brew bundle check` to verify)

# Taps

# =============================================================================
# Core Development Tools
# =============================================================================
brew "git"
brew "bash"                  # Modern bash (macOS ships 3.2)
brew "gh"                    # GitHub CLI
brew "go"
brew "node"                  # Fallback only; dev Node comes from mise
brew "mise"                  # Runtime version manager (replaces nvm)

# Python: runtime only, for ansible/yt-dlp/streamrip and homelab scripts (no Python dev)
brew "python@3.14"

# =============================================================================
# Infrastructure / Homelab
# =============================================================================
brew "ansible"
brew "sshpass"               # SSH password auth (for homelab devices)
brew "mkcert"                # Local SSL certs
brew "nss"                   # Network Security Services (for mkcert)
brew "opentofu"              # Homelab IaC (opentofu/services/*)
brew "shellcheck"            # Lint for homelab/provision shell scripts
brew "syncthing"

# =============================================================================
# Cloud / DevOps
# =============================================================================
brew "azure-cli"
brew "colima"                # Container runtime; start by hand with `colima start` (ssh/config Includes its ssh_config)
brew "docker"                # CLI only, talks to colima (no Docker Desktop)
brew "docker-buildx"         # CLI plugins, found via ~/.docker/config.json cliPluginsExtraDirs
brew "docker-compose"

# =============================================================================
# Databases
# =============================================================================
brew "libpq", link: true     # psql / pg_dump client (no local server)

# =============================================================================
# Media Tools
# =============================================================================
brew "ffmpeg"
brew "yt-dlp"                # Pulls in deno as its JS runtime
brew "gallery-dl"
brew "exiftool"

# =============================================================================
# Document / Text Processing
# =============================================================================
brew "pandoc"
brew "vale"                  # Prose linter
brew "poppler"               # PDF tools (pdftotext, pdftoppm)
brew "whisper.cpp"           # Local speech-to-text

# =============================================================================
# CLI Utilities
# =============================================================================
brew "tree"
brew "git-delta"             # Git pager: side-by-side, syntax-highlighted diffs
brew "fzf"                   # Fuzzy finder (Ctrl-T files, Alt-C dirs)
brew "atuin"                 # Ctrl-R history (SQLite, local only)
brew "fd"                    # Fast find, fzf backend
brew "ripgrep"               # rg: fast recursive grep
brew "jq"                    # JSON on the command line (bin/doctor checks for it)
brew "rtk"                   # Token-saving CLI proxy; Claude Code's Bash hook calls it
brew "starship"              # Prompt
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zoxide"                # Smarter cd (z / zi), replaces the omz z plugin
brew "pv"                    # Pipe viewer (progress bars)
brew "hyperfine"             # Command benchmarking
brew "b2-tools"              # Backblaze B2
brew "chezmoi"               # Dotfiles manager (this repo)
brew "age"                   # Key for chezmoi's encrypted_* files (age-keygen)
brew "mas"                   # Mac App Store CLI
brew "mole"
brew "topgrade"             # Upgrade brew, App Store, npm, mise, etc. in one run

# =============================================================================
# Casks (GUI Applications)
# =============================================================================
cask "1password-cli"
cask "handy"                 # Local dictation (daily driver)
cask "visual-studio-code"
cask "pearcleaner"           # App uninstaller + orphaned-file finder
cask "knockknock"            # Objective-See: lists persistent login/launch items
# cask "nrlquaker-winbox"    # MikroTik Winbox - uncomment if still needed

