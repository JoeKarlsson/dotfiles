# Templated: paths here are target paths (relative to ~), not source names.
{{- if ne .chezmoi.os "darwin" }}
# Linux (claude-dev): only shared, OS-neutral config. Provision owns ~/.bashrc
# and ~/.ssh/config there; zsh, 1Password, Homebrew and VS Code are Mac-only.
.zshrc
.zprofile
.ssh
.Brewfile
.claude/settings.json
.claude/mcp.json
.config/atuin
.config/mise
.config/topgrade.toml
# OpenCode runs only on the Mac (LiteLLM key comes from the macOS Keychain)
.config/opencode
Library
.local/share/obsbot-autotrack
# /social drafts Vale config: Mac-only (Vale is a Brewfile app; its global
# folder is under Library, already ignored above)
social-drafts
{{- end }}
{{- if eq .chezmoi.os "windows" }}
# Windows: the docker modify script is bash + Homebrew jq, Raycast is Mac-only.
# ~/.claude hooks: notify.sh's OSC 777 notifications don't show in Windows
# Terminal, and worktree-hygiene.sh needs BSD stat and Unix pids. statusline.sh
# works in Git Bash (needs jq) and is wired up by the Windows settings.
.docker
.config/raycast
.claude/notify.sh
.claude/worktree-hygiene.sh
{{- else }}
# PowerShell profile (the zsh port) is Windows-only
.config/powershell
# winget package list and AutoHotkey Mac-style shortcuts are Windows-only
.winget.json
Documents/AutoHotkey
{{- end }}
{{- if eq .machine "personal" }}
# docx MCP server is only set up on the work Mac
.claude/mcp.json
{{- end }}
