#!/bin/zsh
# Open OpenCode on Qwen 3.8 27B running on this Mac. Starts llama-server on
# :8099 if it isn't up and stops it when OpenCode exits, so the ~18 GB of
# model memory is only held while you're using it. If the server is already
# running, it's left alone.
set -euo pipefail

model_file="$HOME/models/qwen3.8-27b/Qwen3.8-27B-UD-Q4_K_M.gguf"
health_url="http://127.0.0.1:8099/health"
log_file="$HOME/Library/Logs/llama-server-8099.log"

if [[ ! -f "$model_file" ]]; then
  echo "oc-local: model not found at $model_file" >&2
  echo "oc-local: hf download unsloth/Qwen3.8-27B-GGUF Qwen3.8-27B-UD-Q4_K_M.gguf --local-dir ${model_file:h}" >&2
  exit 1
fi

started_server_pid=""
if ! curl -sf "$health_url" >/dev/null; then
  echo "oc-local: loading Qwen 3.8 27B (about 10 s)..."
  llama-server -m "$model_file" --jinja -ngl 99 -c 65536 -np 1 \
    -ctk q8_0 -ctv q8_0 -fa on --host 127.0.0.1 --port 8099 >"$log_file" 2>&1 &
  started_server_pid=$!
  trap '[[ -n "$started_server_pid" ]] && kill "$started_server_pid" 2>/dev/null' EXIT
  until curl -sf "$health_url" >/dev/null; do
    if ! kill -0 "$started_server_pid" 2>/dev/null; then
      echo "oc-local: llama-server exited during load; see $log_file" >&2
      tail -5 "$log_file" >&2
      exit 1
    fi
    sleep 0.5
  done
fi

# OpenCode 2.4 dropped the TUI's -m flag, so the model comes from inline config.
# --standalone gives OpenCode a private server that reads it; the shared
# background service would keep its own default model.
# `oc-local run "prompt"` runs one non-interactive task; plain `oc-local` opens the TUI.
export OPENCODE_CONFIG_CONTENT='{"model":"mac-local/qwen3.8-27b"}'
if [[ "${1:-}" == "run" ]]; then
  shift
  opencode run --standalone "$@"
else
  opencode --standalone "$@"
fi
