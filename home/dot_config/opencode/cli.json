{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-mocha",
    "mode": "dark"
  },
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "session": {
    "tps": true,
    "thinking": "hide",
    "scrollbar": true
  },
  "diffs": {
    "source": "turn"
  }
}
