{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/cloud-coder",
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (CT 256)",
      "options": {
        "baseURL": "http://192.168.0.190:8080/v1"
      },
      "models": {
        "Qwen3-Coder-30B-A3B-Instruct-UD-Q3_K_XL": {
          "name": "Qwen3 Coder 30B UD-Q3 (llama-server, 24K ctx)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (CT 245)",
      "options": {
        "baseURL": "http://192.168.0.249:11434/v1"
      },
      "models": {
        "qwen3-coder-q3-24k": {
          "name": "Qwen3 Coder 30B UD-Q3 (24K ctx, full GPU)"
        },
        "hf.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:UD-Q3_K_XL": {
          "name": "Qwen3 Coder 30B UD-Q3 (16K ctx)"
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (slow - CPU spill)"
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (small/fast)"
        }
      }
    },
    "openrouter": {
      "models": {
        "qwen/qwen3.8-27b:free": {
          "name": "Qwen 3.8 27B (FREE)"
        },
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B"
        },
        "qwen/qwen3.8-2.4t-a95b": {
          "name": "Qwen 3.8 2.4T-A95B (big)"
        },
        "z-ai/glm-5.3": {
          "name": "GLM 5.3"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3"
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "minimax/minimax-m3": {
          "name": "MiniMax M3"
        },
        "xiaomi/mimo-v2.6-flash": {
          "name": "Mimo V2.6 Flash"
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (CT 261)",
      "options": {
        "baseURL": "http://192.168.0.230:4000/v1",
        "apiKey": "{env:LITELLM_OPENCODE_KEY}"
      },
      "models": {
        "cloud-coder": {
          "name": "cloud-coder: DeepSeek V4.1 Flash (default)",
          "cost": {
            "input": 0.0495,
            "output": 1.32,
            "cache_read": 0.0165,
            "cache_write": 0
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "cloud-coder-pro": {
          "name": "cloud-coder-pro: DeepSeek V4 Pro (hard problems)",
          "cost": {
            "input": 0.2088,
            "output": 0.4176,
            "cache_read": 0.0174,
            "cache_write": 0
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "cloud-smart": {
          "name": "cloud-smart: Qwen 3.8 2.4T (OpenRouter)",
          "cost": {
            "input": 2,
            "output": 6,
            "cache_read": 0.25,
            "cache_write": 0
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "cloud-fast": {
          "name": "cloud-fast: GLM 5.3 Flash (OpenRouter)",
          "cost": {
            "input": 0.15,
            "output": 0.5,
            "cache_read": 0.03,
            "cache_write": 0
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "local-coder": {
          "name": "local-coder: Qwen3 Coder 30B (Ollama)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "local-big": {
          "name": "local-big: Qwen3 Coder 30B (llama-server)",
          "limit": {
            "context": 24576,
            "output": 8192
          }
        },
        "local-smart": {
          "name": "local-smart: Qwen3 14B (Ollama)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "local-fast": {
          "name": "local-fast: Qwen3 8B (Ollama)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "small_model": "litellm/cloud-fast",
  "plugins": [
    "@bybrawe/opencode-goal@1.3.47"
  ]
}
